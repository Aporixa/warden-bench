browser-agent/screenshots/
browser-agent/audio/
*.wav
*.mp3

.DS_Store
Thumbs.db

# Ladder runs hold raw, unredacted responses; publish only after redaction review
operator/ladder/runs/
operator/ladder/checkpoints/
